# Copy this file to `.env` and fill in the values.
# `docker compose` reads `.env` automatically and substitutes the
# ${VAR} references in docker-compose.yml.
#
# All values are optional: the server starts without them, but the
# vulnerability-database updater and some integrations will be limited.

# --- External API credentials -------------------------------------------

# GitHub personal access token (GHSA / GitHub API)
GITHUB_API_KEY=

# npm registry token
NPM_API_KEY=

# NVD API key
NVD_API_KEY=

# Stack Exchange API key
STACK_EXCHANGE_API_KEY=

# --- Optional ------------------------------------------------------------

# When set, the HTTP API requires this key on requests (SRV_ACCESS_KEY).
SRV_ACCESS_KEY=
